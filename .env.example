# Base de datos local de desarrollo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pls_al_llamado

# Payload CMS. Usa un secreto aleatorio distinto en cada entorno.
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Opcionales: rendimiento de la conexión a PostgreSQL
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# Chatbot de n8n (opcional)
N8N_CHATBOT_WEBHOOK_URL=https://example.com/webhook/pls-chat
N8N_CHATBOT_AUTH_HEADER=x-pls-token
N8N_CHATBOT_TOKEN=replace-with-a-long-random-token
N8N_CHATBOT_TIMEOUT_MS=8000

# Cloudflare R2 (opcional; deja R2_ENABLED=false si no lo vas a usar)
R2_ENABLED=false
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=replace-with-r2-bucket-name
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PREFIX=media
